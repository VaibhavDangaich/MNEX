# AI CLI Agent Configuration
# Copy this file to .env and fill in your API keys

# ═══════════════════════════════════════════════════════════════
# LLM Provider (Required - choose one)
# ═══════════════════════════════════════════════════════════════

# OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# OR Google Gemini API Key
# Get yours at: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key-here

# ═══════════════════════════════════════════════════════════════
# Supermemory (Optional - for semantic search)
# ═══════════════════════════════════════════════════════════════

# Supermemory API Key for long-term semantic memory
# Get yours at: https://supermemory.ai
# SUPERMEMORY_API_KEY=sm_your-supermemory-api-key-here

# ═══════════════════════════════════════════════════════════════
# Debug Options (Optional)
# ═══════════════════════════════════════════════════════════════

# Enable debug mode for verbose logging
# AI_DEBUG=true
